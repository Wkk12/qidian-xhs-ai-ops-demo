@@ -1,12 +1,40 @@
 package main
 
 import (
+	"errors"
 	"sync"
 	"testing"
 
 	"github.com/stretchr/testify/assert"
 )
 
+// TestLoginSessionStatus 覆盖会话查询、落盘失败与退出后迟到的扫码结果。
+func TestLoginSessionStatus(t *testing.T) {
+	var l loginSessions
+	seq := l.start(func() {})
+	result, ok := l.status()
+	assert.True(t, ok)
+	assert.Equal(t, "waiting", result.State)
+	assert.False(t, result.IsLoggedIn)
+	assert.False(t, l.complete(seq, &LoginStatusResponse{}, func() error { return errors.New("disk failure") }))
+	result, _ = l.status()
+	assert.Equal(t, "error", result.State)
+	assert.False(t, result.IsLoggedIn)
+	seq = l.start(func() {})
+	assert.True(t, l.complete(seq, &LoginStatusResponse{Username: "测试", UserID: "user"}, func() error { return nil }))
+	l.finish(seq)
+	result, ok = l.status()
+	assert.True(t, ok)
+	assert.True(t, result.IsLoggedIn)
+	assert.Equal(t, "confirmed", result.State)
+	l.reset()
+	saved := false
+	assert.False(t, l.complete(seq, &LoginStatusResponse{}, func() error { saved = true; return nil }))
+	assert.False(t, saved)
+	_, ok = l.status()
+	assert.False(t, ok)
+}
+
 // TestLoginSessions 固定「同一时刻只保留一个待扫码会话」这条约束。
 //
 // 这是浏览器不再堆积的依据：每个待扫码会话都占着一个浏览器活到超时为止，
