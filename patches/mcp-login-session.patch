 // loginSessions 管理「已发出二维码、还在等扫码」的登录会话。
 //
@@ -8,9 +11,11 @@ import "sync"
 // 但没有任何东西拦着重复调用，于是每调一次就多一个浏览器活到超时为止。
 // 这里的约束是：同一时刻只保留一个待扫码会话，开新的就把旧的关掉。
 type loginSessions struct {
-	mu     sync.Mutex
-	seq    uint64
-	cancel func()
+	mu      sync.Mutex
+	seq     uint64
+	cancel  func()
+	result  *LoginStatusResponse
+	updated time.Time
 }
 
 // start 结束上一个待扫码会话（如果有），登记新的，返回本次会话的序号。
@@ -21,6 +26,8 @@ func (l *loginSessions) start(cancel func()) uint64 {
 	l.seq++
 	seq := l.seq
 	l.cancel = cancel
+	l.result = &LoginStatusResponse{State: "waiting", SessionID: seq}
+	l.updated = time.Now()
 	l.mu.Unlock()
 
 	// 放到锁外调用：取消动作会触发对方 goroutine 的收尾，避免相互等待
@@ -38,5 +45,52 @@ func (l *loginSessions) finish(seq uint64) {
 
 	if l.seq == seq {
 		l.cancel = nil
+		if l.result != nil && l.result.State == "waiting" {
+			l.result.State = "expired"
+			l.updated = time.Now()
+		}
+	}
+}
+
+// status 返回正在扫码或刚结束的会话状态，不创建另一个未登录浏览器。
+func (l *loginSessions) status() (*LoginStatusResponse, bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.result == nil || (l.cancel == nil && time.Since(l.updated) > 30*time.Second) {
+		return nil, false
+	}
+	result := *l.result
+	return &result, true
+}
+
+// complete 仅当前会话允许保存；保存失败不能宣称已登录。
+func (l *loginSessions) complete(seq uint64, user *LoginStatusResponse, save func() error) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if seq != l.seq {
+		return false
+	}
+	l.updated = time.Now()
+	if err := save(); err != nil {
+		l.result = &LoginStatusResponse{State: "error", Error: "保存登录凭据失败: " + err.Error(), SessionID: seq}
+		return false
+	}
+	user.IsLoggedIn = true
+	user.State = "confirmed"
+	user.SessionID = seq
+	l.result = user
+	return true
+}
+
+// reset 在退出或换号时取消扫码，禁止旧会话重新写入凭据。
+func (l *loginSessions) reset() {
+	l.mu.Lock()
+	cancel := l.cancel
+	l.seq++
+	l.cancel = nil
+	l.result = nil
+	l.mu.Unlock()
+	if cancel != nil {
+		cancel()
 	}
 }
